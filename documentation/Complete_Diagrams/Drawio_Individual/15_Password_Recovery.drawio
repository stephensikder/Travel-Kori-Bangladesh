        <mxCell id="pr_1" value="User submits registered email&lt;br&gt;via POST /api/auth/forgot-password" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="640" y="200" width="320" height="70" as="geometry" /></mxCell>
