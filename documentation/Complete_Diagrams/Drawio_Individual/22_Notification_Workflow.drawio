        <mxCell id="nt_1" value="Event Occurs: Booking Created, Guide Verified,&lt;br&gt;or Security Alert Triggered" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="630" y="200" width="340" height="70" as="geometry" /></mxCell>
        <mxCell id="nt_2" value="Backend Inserts Document in notifications Collection&lt;br&gt;{ userId, type, title, message, isRead: false }" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="630" y="310" width="340" height="70" as="geometry" /></mxCell>
        <mxCell id="nt_3" value="Client nav.js Polls /api/notifications/:userId&lt;br&gt;Every 25 Seconds / on Page Mount" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="630" y="420" width="340" height="70" as="geometry" /></mxCell>
        <mxCell id="nt_4" value="Filter Unread Alerts (isRead == false)&lt;br&gt;Compute unreadCount" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="630" y="530" width="340" height="70" as="geometry" /></mxCell>
        <mxCell id="nt_dec1" value="unreadCount &gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="725" y="640" width="150" height="80" as="geometry" /></mxCell>
        <mxCell id="nt_badge_on" value="Display Red Counter Badge on Bell Icon&lt;br&gt;(e.g. &#x27;1&#x27;, &#x27;2&#x27;, &#x27;9+&#x27;)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="280" y="645" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="nt_badge_off" value="Hide Notification Counter Badge&lt;br&gt;(badge.style.display = &#x27;none&#x27;)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1060" y="645" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="nt_5" value="User Clicks Bell Icon to Open Dropdown&lt;br&gt;Clicks &#x27;Mark as read&#x27; / &#x27;Mark all as read&#x27;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="630" y="770" width="340" height="70" as="geometry" /></mxCell>
