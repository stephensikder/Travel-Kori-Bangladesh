        <mxCell id="c_3" value="Figure 10.26: Booking Lifecycle State Transition Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;fontFamily=Times New Roman;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="c_4" value="State Machine Model for Hotel, Transport, and Guide Reservations" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#333333;fontFamily=Times New Roman;fontSize=16;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="50" y="65" width="1500" height="25" as="geometry" /></mxCell>
        <mxCell id="st_start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="150" y="300" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="st_pending" value="&lt;b&gt;STATE: Pending&lt;/b&gt;&lt;br&gt;Reservation submitted by traveler;&lt;br&gt;awaiting partner / admin review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="260" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="st_confirmed" value="&lt;b&gt;STATE: Confirmed&lt;/b&gt;&lt;br&gt;Accepted by Hotel / Transport / Guide;&lt;br&gt;Seats &amp; Rooms officially held" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="260" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="st_completed" value="&lt;b&gt;STATE: Completed&lt;/b&gt;&lt;br&gt;Service fulfilled; eligible for&lt;br&gt;traveler review &amp; rating" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="260" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="st_cancelled" value="&lt;b&gt;STATE: Cancelled&lt;/b&gt;&lt;br&gt;Declined by partner or&lt;br&gt;voided by administrator" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="550" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="st_end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1250" y="590" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="c_5" value="Submit Request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="st_start" target="st_pending"><mxGeometry relative="1" as="geometry" /></mxCell>
