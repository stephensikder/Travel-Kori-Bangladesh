          <mxGeometry x="1550" y="220" width="20" height="850" as="geometry" />
        </mxCell>
        <mxCell id="c_5" value="1. Fill &amp; submit booking form" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="bar_u" target="bar_ui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_6" value="2. POST /api/hotel-bookings (JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="bar_ui" target="bar_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_7" value="3. Dispatch to route handler" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="bar_api" target="bar_ctl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_8" value="4. findOne({ _id: hotelId, vacant: true })" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="bar_ctl" target="bar_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_9" value="5. Return verified room package doc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;dashed=1;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="bar_db" target="bar_ctl">
