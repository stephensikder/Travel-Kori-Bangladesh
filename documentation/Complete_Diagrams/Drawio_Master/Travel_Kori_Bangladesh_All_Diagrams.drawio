  <diagram id="23_api_request_response" name="23_API_Request_Response">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_3" value="Figure 10.23: REST API Request-Response Lifecycle Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;fontFamily=Times New Roman;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c_4" value="Full Execution Pipeline from Fetch Request to BSON Execution &amp; Response" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#333333;fontFamily=Times New Roman;fontSize=16;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="65" width="1500" height="25" as="geometry" />
        </mxCell>
        <mxCell id="api_s" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="785" y="140" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="api_1" value="1. Client Browser Invokes Fetch API&lt;br&gt;fetch('/api/...', { method, headers, body })" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="630" y="200" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="api_2" value="2. Express Middleware Pipeline&lt;br&gt;• CORS Headers (Access-Control-Allow-Origin)&lt;br&gt;• express.json({ limit: '15mb' }) Body Parser" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="630" y="310" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="api_3" value="3. Express Router Matching&lt;br&gt;Match HTTP Method &amp; Parameterized Route Path" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="630" y="430" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="api_4" value="4. Route Handler &amp; Input Validation&lt;br&gt;Validate Types, Bounds, Dates, Base64 MIME" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="630" y="540" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="api_dec1" value="Validation&lt;br&gt;Passed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="725" y="650" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="api_err1" value="Return HTTP 400 Bad Request&lt;br&gt;{ success: false, message: '...' }" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="280" y="655" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="api_5" value="5. MongoDB Driver Query Execution&lt;br&gt;db.collection(...).find() / insertOne() / updateOne()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="630" y="770" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="api_6" value="6. JSON Serialization &amp; Header Transmission&lt;br&gt;res.status(200).json({ success: true, ... })" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="630" y="880" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="api_e" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="785" y="990" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="api_s" target="api_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="api_1" target="api_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="api_2" target="api_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="api_3" target="api_4">
          <mxGeometry relative="1" as="geometry" />
