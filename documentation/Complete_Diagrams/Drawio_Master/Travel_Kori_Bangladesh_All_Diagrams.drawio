        <mxCell id="c_10" value="6. insertOne(bookingDoc) &amp; insertOne(notificationDoc)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="bar_ctl" target="bar_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_11" value="7. Return insertedId &amp; reference PNR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;dashed=1;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="bar_db" target="bar_ctl">
