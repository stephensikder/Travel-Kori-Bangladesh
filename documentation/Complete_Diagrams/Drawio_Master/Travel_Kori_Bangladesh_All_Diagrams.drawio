        <mxCell id="ll_db" value="&lt;b&gt;:MongoDBEngine&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1460" y="140" width="200" height="70" as="geometry" />
