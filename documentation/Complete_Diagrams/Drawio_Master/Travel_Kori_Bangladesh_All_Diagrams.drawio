  <diagram id="04_actor_role" name="04_Actor_Role">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_3" value="Figure 10.4: Actor and Role Hierarchy (RBAC Capability Matrix)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;fontFamily=Times New Roman;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c_4" value="Role Inheritance and Security Boundary Model" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#333333;fontFamily=Times New Roman;fontSize=16;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="65" width="1500" height="25" as="geometry" />
        </mxCell>
        <mxCell id="r_vis" value="&lt;b&gt;ROLE 1: PUBLIC VISITOR&lt;/b&gt;&lt;br&gt;• Browse 64 Districts Directory&lt;br&gt;• Search Hotels &amp; Transport&lt;br&gt;• View Attractions &amp; Tour Guides&lt;br&gt;• Access Route Map Network" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r_trav" value="&lt;b&gt;ROLE 2: AUTHENTICATED TRAVELER&lt;/b&gt;&lt;br&gt;(Inherits Visitor Capabilities)&lt;br&gt;• Book Hotels, Seats, Tour Guides&lt;br&gt;• Generate Trip Itineraries &amp; Budgets&lt;br&gt;• Download PDF Travel Tickets&lt;br&gt;• Submit Verified Guide Reviews&lt;br&gt;• Profile &amp; Photo Management" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="200" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p_lane" value="&lt;b&gt;SERVICE PROVIDER PARTNER ROLES (Pending / Approved Admin Verification)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=18;fontStyle=1;startSize=40;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="430" width="1400" height="300" as="geometry" />
        </mxCell>
        <mxCell id="r_hotel" value="&lt;b&gt;ROLE 3: HOTEL OWNER&lt;/b&gt;&lt;br&gt;• Hotel Partner Portal Access&lt;br&gt;• Manage Incoming Room Bookings&lt;br&gt;• Update Stay Status (Confirmed/Cancel)&lt;br&gt;• Manage Property Meta &amp; Rates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="140" y="510" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="r_trans" value="&lt;b&gt;ROLE 4: TRANSPORT OPERATOR&lt;/b&gt;&lt;br&gt;• Transport Portal Access&lt;br&gt;• Review Coach/Train/Ship Bookings&lt;br&gt;• Verify Passenger PNR Status&lt;br&gt;• Monitor Occupancy Rates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="560" y="510" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="r_guide" value="&lt;b&gt;ROLE 5: TOUR GUIDE&lt;/b&gt;&lt;br&gt;• Guide Operations Portal Access&lt;br&gt;• Accept / Conclude Tour Requests&lt;br&gt;• Toggle Available / Unavailable&lt;br&gt;• Upload &amp; Sync Guide Photo&lt;br&gt;• Manage Daily Rate &amp; Bio" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="980" y="510" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="r_admin" value="&lt;b&gt;ROLE 6: SYSTEM ADMINISTRATOR (Root Governance)&lt;/b&gt;&lt;br&gt;• Isolated Admin Navigation Layout (No Public Links on Admin Interfaces)&lt;br&gt;• Master Bookings Audit &amp; Status Overrides&lt;br&gt;• User Account Moderation &amp; RBAC Suspension (Active / Suspended Reason Logging)&lt;br&gt;• Tour Guide Verification &amp; Licensing&lt;br&gt;• Comprehensive Catalog Management (Districts, Spots, Hotels, Schedules)&lt;br&gt;• Real-Time Security Alerts &amp; Immutable Audit Log Trail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="800" width="900" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c_5" value="User Registration / Login" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="r_vis" target="r_trav">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_6" value="Partner Registration Application" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="r_trav" target="r_hotel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_7" value="Partner Registration Application" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="r_trav" target="r_trans">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_8" value="Partner Registration Application" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="r_trav" target="r_guide">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_9" value="Supervised By" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;dashed=1;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="r_hotel" target="r_admin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
