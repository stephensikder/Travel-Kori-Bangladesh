        </mxCell>
        <mxCell id="c_14" value="10. Render confirmation card &amp; enable PDF download" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;dashed=1;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="bar_ui" target="bar_u">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
