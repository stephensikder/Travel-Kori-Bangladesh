        <mxCell id="ll_ctl" value="&lt;b&gt;:BookingController&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1100" y="150" width="220" height="60" as="geometry" />
