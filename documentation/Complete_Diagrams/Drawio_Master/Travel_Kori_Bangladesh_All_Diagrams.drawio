        <mxCell id="c_4" value="Protected Route Guarding and Interface Authorization Boundaries" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#333333;fontFamily=Times New Roman;fontSize=16;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="65" width="1600" height="25" as="geometry" />
        </mxCell>
        <mxCell id="rbac_vis" value="&lt;b&gt;GUEST VISITOR&lt;/b&gt;&lt;br&gt;• index.html (Home)&lt;br&gt;• 64-districts.html&lt;br&gt;• hotel-booking.html&lt;br&gt;• transport.html&lt;br&gt;• guides.html&lt;br&gt;• route-map.html&lt;br&gt;• login.html / signup.html" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="rbac_trav" value="&lt;b&gt;AUTHENTICATED TRAVELER&lt;/b&gt;&lt;br&gt;(Inherits Visitor +)&lt;br&gt;• dashboard.html&lt;br&gt;• my-profile.html&lt;br&gt;• booking.html (Trip Planner)&lt;br&gt;• PDF Ticket Export&lt;br&gt;• Guide Reviews&lt;br&gt;• Universal Notifications" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="400" y="200" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="rbac_hotel" value="&lt;b&gt;HOTEL PARTNER&lt;/b&gt;&lt;br&gt;(Pending / Approved)&lt;br&gt;• hotel-portal.html&lt;br&gt;• Review Guest Bookings&lt;br&gt;• Confirm / Cancel Stays&lt;br&gt;• Property Rate Settings&lt;br&gt;• Partner Notifications" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="720" y="200" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="rbac_trans" value="&lt;b&gt;TRANSPORT OPERATOR&lt;/b&gt;&lt;br&gt;(Pending / Approved)&lt;br&gt;• transport-portal.html&lt;br&gt;• Fleet Trip Overview&lt;br&gt;• Passenger Manifest&lt;br&gt;• PNR Validation&lt;br&gt;• Partner Notifications" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1040" y="200" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="rbac_guide" value="&lt;b&gt;TOUR GUIDE PARTNER&lt;/b&gt;&lt;br&gt;(Approved Status Required)&lt;br&gt;• guide-portal.html&lt;br&gt;• Photo &amp; Rate Settings&lt;br&gt;• Accept Tour Requests&lt;br&gt;• Availability Toggle&lt;br&gt;• Guide Notifications" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1360" y="200" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="rbac_admin" value="&lt;b&gt;SYSTEM ADMINISTRATOR (Exclusive Root Interface)&lt;/b&gt;&lt;br&gt;• admin.html (Dedicated isolated navbar with TK Logo, Bell, Admin Profile, Panel, Logout ONLY)&lt;br&gt;• Master Tour Bookings Audit &amp; Status Overrides&lt;br&gt;• User Account Management &amp; Suspension (Active / Suspended Reason Logging)&lt;br&gt;• Tour Guide Verification &amp; Verification Status Toggle&lt;br&gt;• Full Catalog Management (Districts, Spots, Hotels, Transportation Schedules)&lt;br&gt;• Real-time Security Monitoring &amp; Immutable Security Audit Trail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="520" width="1200" height="220" as="geometry" />
        </mxCell>
        <mxCell id="rbac_guard" value="&lt;b&gt;FRONTEND &amp; BACKEND AUTHORIZATION ENFORCEMENT&lt;/b&gt;&lt;br&gt;• Client: sessionStorage.getItem('travelKoriUser') verifies role and redirects unauthenticated requests&lt;br&gt;• nav.js: Renders isolated admin bar for role=='admin', renders public links for travelers/guests&lt;br&gt;• Backend: Route middleware checks user.userType=='admin' before mutating sensitive collections" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=16;fontStyle=1;" vertex="1" parent="1">
