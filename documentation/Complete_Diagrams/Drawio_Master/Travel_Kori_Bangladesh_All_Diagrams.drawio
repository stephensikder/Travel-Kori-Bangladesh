        <mxCell id="bar_ui" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="500" y="220" width="20" height="850" as="geometry" />
        </mxCell>
        <mxCell id="bar_api" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="850" y="220" width="20" height="850" as="geometry" />
        </mxCell>
        <mxCell id="bar_ctl" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1200" y="220" width="20" height="850" as="geometry" />
        </mxCell>
