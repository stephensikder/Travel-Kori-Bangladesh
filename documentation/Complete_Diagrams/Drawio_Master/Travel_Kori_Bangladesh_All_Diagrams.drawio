        <mxCell id="c_12" value="8. HTTP 200 { success: true, booking: {...} }" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;dashed=1;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1" source="bar_ctl" target="bar_api">
          <mxGeometry relative="1" as="geometry" />
